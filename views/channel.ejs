<!DOCTYPE html>
<html lang="ru">
	<%- include('head'); -%>

	<body class="meeting-page">
		<main id="app">
			<div class="wrap max meeting-shell" :class="{'in-call':callInitiated,'before-call':!callInitiated}" v-cloak>
 <header class="meeting-header"><div class="service-brand"><span class="brand-icon"><i class="icon-video" aria-hidden="true"></i></span><span>Душа компании</span></div><div class="meeting-context"><strong>Видеовстреча</strong><span>Душа Компании</span></div><span class="meeting-badge" v-if="callInitiated">Участников: {{peersArray.length + 1}}</span><span class="meeting-badge" v-else>Подготовка к звонку</span></header>
				<section id="toast" v-bind:class="toast.type + (toast.message ? ' show' : '')" v-on:click="toast.message = ''">
					{{toast.message}}
				</section>

				<section id="pre-call" v-if="!callInitiated">
 <div class="precall-heading"><h1>Перед встречей</h1><p>Проверьте, как вас видно и слышно.</p></div>
					<div id="videos" class="layout-1">
						<div class="video self">
							<div class="camera-placeholder" v-if="!videoEnabled"><span class="avatar-placeholder">{{(name || 'Вы').slice(0,1).toUpperCase()}}</span><span>Камера выключена</span></div>
 <video id="preCallVideo" class="video self" autoplay muted playsinline></video>
						</div>
					</div>
				</section>

				<section v-if="callInitiated">
					<div id="videos" v-bind:class="videoLayoutClass">
						<div class="video" v-for="(peer, i) in peersArray" v-bind:key="peer.id"
							:class="{'is-expanded': expandedPeerId === peer.id}"
							:role="expandedPeerId === peer.id ? 'dialog' : null"
							:aria-modal="expandedPeerId === peer.id ? 'true' : null"
							:aria-label="expandedPeerId === peer.id ? peer.name : null">
							<video
								v-bind:ref="'peerVideo' + i"
								v-bind:src-object.prop.camel="peer.stream"
								autoplay
								playsinline
							></video>
							<button type="button" class="fullscreen-btn"
								:aria-label="expandedPeerId === peer.id ? 'Назад к участникам' : 'На весь экран'"
								:title="expandedPeerId === peer.id ? 'Назад к участникам' : 'На весь экран'"
								:aria-expanded="expandedPeerId === peer.id"
								@click="toggleExpandedVideo(peer.id)">
								<span v-if="expandedPeerId === peer.id">← Назад</span>
								<i v-else class="icon-maximize" aria-hidden="true"></i>
							</button>
							<div class="meta">
								{{peer.name}}
								<i v-bind:class="'green icon-mic'" v-if="peer.isTalking"></i>
							</div>
						</div>
						<div class="video self">
							<video
								v-bind:ref="'selfVideo'"
								v-bind:src-object.prop.camel="localMediaStream"
								autoplay
								muted
								playsinline
							></video>
							<div class="meta">{{name}} (Вы)</div>
						</div>
					</div>
				</section>

				<div id="blanket" v-if="showExtraControls || showChat" @click="resetPopups"></div>
				<section id="controls">
 <div class="entry-heading" v-if="!callInitiated"><span class="entry-kicker">ВИДЕОВСТРЕЧА</span><h1>Присоединиться к коллегам</h1><p>Представьтесь и нажмите «Набрать».</p></div>
					<section id="extra" v-if="showExtraControls">
						<ul>
							<li class="action" @click="showAudioDevices = !showAudioDevices">
								<i class="icon-mic"></i> Изменить аудио
							</li>
							<li
								class="action indent"
								v-if="showAudioDevices"
								v-for="(audioDevice, i) in audioDevices"
								v-bind:key="audioDevice.deviceId"
								@click="selectedAudioDeviceId = audioDevice.deviceId"
							>
								<i class="icon-minus" v-if="selectedAudioDeviceId !== audioDevice.deviceId"></i>
								<i class="icon-check" v-if="selectedAudioDeviceId === audioDevice.deviceId"></i>
								{{audioDevice.label}}
							</li>

							<li class="action" @click="showVideoDevices = !showVideoDevices">
								<i class="icon-video"></i> Изменить видео
							</li>
							<li
								class="action indent"
								v-if="showVideoDevices"
								v-for="(videoDevice, i) in videoDevices"
								v-bind:key="videoDevice.deviceId"
								@click="selectedVideoDeviceId = videoDevice.deviceId"
							>
								<i class="icon-minus" v-if="selectedVideoDeviceId !== videoDevice.deviceId"></i>
								<i class="icon-check" v-if="selectedVideoDeviceId === videoDevice.deviceId"></i>
								{{videoDevice.label}}
							</li>

							<li class="action" @click="copyURL"><i class="icon-link"></i> Скопировать ссылку</li>
						</ul>
					</section>

					<section id="chats" v-if="callInitiated && showChat" aria-label="Чат встречи">
 <h2 class="chat-heading">Чат встречи</h2>
						<div id="scroll">
							<div class="chat" v-for="(chat, i) in chats" v-bind:key="i">
								<div><span class="name">{{chat.name}}:</span> <span v-html="linkify(chat.message)"></span></div>
								<div class="date">{{formatDate(chat.date)}}</div>
							</div>
						</div>

						<div class="chat">
							<textarea
								v-model="chatMessage"
								rows="1"
								v-on:keydown.enter="sendChat"
								placeholder="Введите ваше сообщение"
							></textarea>
						</div>
					</section>

					<section id="name" v-if="!callInitiated && !showExtraControls">
 <label class="field-label" for="myName">Ваше имя</label>
						<input
							type="text"
							id="myName" aria-label="Ваше имя"
							v-model="name"
							v-on:keyup="updateName"
							v-on:keyup.enter="initiateCall"
							placeholder="Ваше имя"
							maxlength="50"
						/>
					</section>

					<section id="buttons">
						<button aria-label="Микрофон" title="Микрофон" :aria-pressed="audioEnabled" :class="{'device-off':!audioEnabled}" @click="callInitiated ? toggleAudio() : togglePreCallAudio()">
							<i :class="'icon-mic'+(audioEnabled ? '' : '-off')"></i>
						</button>
						<button aria-label="Камера" title="Камера" :aria-pressed="videoEnabled" :class="{'device-off':!videoEnabled}" @click="callInitiated ? toggleVideo() : togglePreCallVideo()">
							<i :class="'icon-video'+(videoEnabled ? '' : '-off')"></i>
						</button>
						<button :aria-label="isScreenSharing ? 'Остановить показ экрана' : 'Показать экран'" :title="isScreenSharing ? 'Остановить показ экрана' : 'Показать экран'" :aria-pressed="isScreenSharing" @click="toggleScreenShare" v-if="callInitiated && screenShareSupported" :class="{red:isScreenSharing}"><i class="icon-screen" aria-hidden="true"></i></button>
						<button aria-label="Настройки звонка" title="Настройки звонка" @click="toggleExtraControls"><i class="icon-more-vertical"></i></button>
						<button type="button" class="red" v-if="callInitiated" aria-label="Покинуть звонок" title="Покинуть звонок" @click="endCall">
							<i class="icon-phone-off" aria-hidden="true"></i>
						</button>
						<button class="join" v-if="!callInitiated" v-on:click="initiateCall">
							<i class="icon-phone"></i>&nbsp; Набрать
						</button>
					</section>
 <p class="entry-help" v-if="!callInitiated">Камеру и микрофон можно выключить до входа.</p>
				</section>
			</div>
		</main>
	</body>
</html>
