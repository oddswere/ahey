<head>
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
	<meta
		name="viewport"
		content="width=device-width, height=device-height, initial-scale=1.0"
	/>
	<meta name="description" content="Душа компании - корпоративный веб сервис для видеозвонков. Без регистрации, без скачивания, по ссылке." />
	<meta
		name="keywords"
		content="group video chat, video communication, multiparty video chat, video chat, webrtc, peer to peer, p2p"
	/>
	<meta name="apple-mobile-web-app-status-bar-style" content="default" />
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="application-name" content="Душа компании" />
	<meta name="theme-color" content="#f5f6f8" />

	<!-- Meta data for link fetching -->
	<meta property="og:url" content="https://call.motorzona.ru" />
	<meta property="og:image" content="/icons/icon-512x512.png" />
	<meta property="og:title" content="Душа компании" />
	<meta property="og:description" content="Корпоративный веб сервис для видеозвонков. Без регистрации, без скачивания, по ссылке." />

	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
	<link rel="icon" href="/favicon.png" sizes="48x48" type="image/png" />
	<link rel="manifest" href="/manifest.json" />

	<link rel="stylesheet" href="/styles.css" />
	<link rel="stylesheet" href="/company-ui.css" />

	<% if(page==="channel" ) { %>
	<script defer src="/socket.io/socket.io.js"></script>
	<script defer src="/vue.global.prod.js"></script>
	<script defer src="/ice-config.js"></script>
	<script defer src="/peer.js"></script>
	<script defer src="/app.js"></script>
	<script defer src="/video-corners.js"></script>
	<% } %>

	<title>Душа компании / <%= title %></title>
</head>
