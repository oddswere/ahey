{
  "name": "naberesh",
  "version": "2.0.11",
  "description": "Душа компании — корпоративные видеозвонки",
  "main": "init.js",
  "scripts": {
    "start": "node ./scripts/pre-start.js && node init.js",
    "test": "node --test tests/*.cjs",
    "format:ejs": "prettier --write \"views/**/*.ejs\"",
    "docker": "docker build -t naberesh . && docker run -p 824:824 naberesh"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "better-sqlite3": "^9.6.0",
    "socket.io": "^4.7.5",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "3.4.2"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": false,
    "trailingComma": "es5",
    "tabWidth": 2,
    "useTabs": true,
    "overrides": [
      {
        "files": [
          "*.ejs"
        ],
        "options": {
          "parser": "html"
        }
      }
    ]
  }
}
